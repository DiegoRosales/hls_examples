/*
 * sdtgen derives the root compatible from the Vivado board name ("zybo"),
 * producing only "xlnx,zybo". The Zynq machine driver matches on
 * "xlnx,zynq-7000", so without it the SLCR iomap never runs and
 * clk_register_zynq_pll crashes with a NULL dereference at boot.
 */
/ {
	compatible = "xlnx,zybo", "xlnx,zynq-7000";
};

/*
 * sdtgen enables gem0 with phy-mode = "rgmii-id" but emits no PHY node or
 * phy-handle, because the PHY is board-level info Vivado does not carry.
 * Without it the macb/phylink driver has no link modes to validate and fails
 * with "Could not attach PHY (-22)". The Zybo (7z010) has a Realtek RTL8211E
 * on MDIO address 0.
 */
&gem0 {
	phy-handle = <&ethernet_phy>;

	ethernet_phy: ethernet-phy@0 {
		reg = <0>;
		device_type = "ethernet-phy";
	};
};
